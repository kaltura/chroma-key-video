{
  "name": "chroma-key-video",
  "version": "1.1.0",
  "description": "Real-time green/blue-screen chroma keying for HTML video. Zero dependencies, shared-WebGL architecture for unlimited concurrent players, Canvas2D fallback.",
  "type": "module",
  "main": "src/chromakey.js",
  "module": "src/chromakey.js",
  "exports": {
    ".": "./src/chromakey.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "playwright test --project=chromium",
    "bench": "playwright test --project=bench",
    "bench:footage": "BENCH_SRC=/test/assets/greenscreen-hair.mp4 playwright test --project=bench",
    "bench:firefox": "playwright test --project=bench-firefox",
    "bench:webkit": "playwright test --project=bench-webkit",
    "bench:all": "playwright test --project=bench --project=bench-firefox --project=bench-webkit",
    "check": "node --check src/chromakey.js && npm run check:size",
    "check:size": "node scripts/check-size.mjs",
    "serve": "node test/serve.mjs"
  },
  "keywords": [
    "chroma-key",
    "green-screen",
    "video",
    "webgl",
    "alpha",
    "transparent-video"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "esbuild": "^0.28.2",
    "hls.js": "^1.7.1"
  }
}
